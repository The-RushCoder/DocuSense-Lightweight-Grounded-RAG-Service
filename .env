# ============================================================
# DocuSense â€” Environment Configuration
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Google Gemini â€” LLM generation only
# Get your key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# HuggingFace â€” Embeddings only (BAAI/bge-small-en-v1.5)
# No API key required, runs locally
# ------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------
# RAG Configuration
# CHUNK_SIZE: characters per chunk (600 is a balanced default)
# CHUNK_OVERLAP: overlap between consecutive chunks (75)
# TOP_K: number of FAISS candidates to retrieve
# SIMILARITY_THRESHOLD: minimum cosine similarity [0.0–1.0]
# SOURCE_SNIPPET_LENGTH: chars shown per source in response
# ------------------------------------------------------------
CHUNK_SIZE=600
CHUNK_OVERLAP=75
TOP_K=3
SIMILARITY_THRESHOLD=0.70
SOURCE_SNIPPET_LENGTH=300

# ------------------------------------------------------------
# Storage Paths
# ------------------------------------------------------------
FAISS_INDEX_PATH=storage/faiss
DOCUMENT_PATH=data/policy.md

# ------------------------------------------------------------
# API Server
# ------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000

# ------------------------------------------------------------
# Frontend Server
# ------------------------------------------------------------
FRONTEND_PORT=3000